      given-names: Jordi
    - family-names: Costa
      given-names: Tiago
    - family-names: de Polavieja
      given-names: Gonzalo G.
  journal: eLife
  volume: 14
  year: 2026
  doi: 10.7554/eLife.107602
  url: https://doi.org/10.7554/eLife.107602

